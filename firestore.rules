rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check user role from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (resource == null || resource.data.role == 'admin' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin'));
    }

    // Global site settings (branding, logo, contact details)
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isVerified']) || isAdmin());
    }

    // Properties collection
    match /properties/{propertyId} {
      allow read: if resource.data.verificationStatus == 'verified' || 
                    (isAuthenticated() && resource.data.ownerId == request.auth.uid) || 
                    isAdmin();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && 
        (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Favourites collection
    match /favourites/{favId} {
      allow read, write: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Enquiries collection
    match /enquiries/{enquiryId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.buyerId == request.auth.uid || 
         resource.data.ownerId == request.auth.uid || 
         isAdmin());
    }
  }
}
